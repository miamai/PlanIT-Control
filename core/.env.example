ENVIRONMENT=development
LOG_LEVEL=INFO
# Tiger Cloud URLs must retain sslmode=require. Keep real credentials in the
# ignored .env file or deployment secret storage.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DOCKER_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DB_REQUIRE_TLS=true
CORS_ORIGINS=["http://localhost:5173"]

# Replace with at least 32 random bytes before production.
JWT_SECRET_KEY=development-only-planit-jwt-secret-change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
REFRESH_COOKIE_NAME=planit_refresh_token
# Required only while running the explicit one-time init-admin command.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=

NWS_USER_AGENT=PlanIT-Control/0.1 (operations@example.com)
NASA_FIRMS_MAP_KEY=
LIGHTNING_PROVIDER=disabled
REQUEST_TIMEOUT_SECONDS=15

WEATHER_POLL_SECONDS=900
WEATHER_ALERT_POLL_SECONDS=300
USGS_POLL_SECONDS=900
WILDFIRE_POLL_SECONDS=2700
WORKER_TICK_SECONDS=30
ENABLED_PROVIDERS=[]
ALERT_THRESHOLD_PROFILE=demo
HEAT_HIGH_THRESHOLD_F=103
HEAT_CRITICAL_THRESHOLD_F=125
SOIL_MODERATE_RAINFALL_MM_72H=50.8
SOIL_HIGH_RAINFALL_MM_72H=101.6
LIGHTNING_RADIUS_MILES=10
LIGHTNING_ALL_CLEAR_MINUTES=30
WILDFIRE_RADIUS_MILES=25
WILDLIFE_SHARE_RADIUS_MILES=10

# The ML container owns model artifacts and Gemini access. Core receives validated results only.
ML_ENABLED=false
ML_BASE_URL=http://localhost:8001
ML_TIMEOUT_SECONDS=120
ML_BRIEFING_BACKEND=gemini
